# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# base44 data export (tenant business data, not for version control)
/base44-export

# typescript
*.tsbuildinfo
next-env.d.ts

# build output (regenerated by vite build; also carries the public Mapbox token which trips GitHub secret scanning)
/dist

# one-off QBO diagnostics (read credentials; never commit)
/qbo-prefs-toggle.mjs
/qbo-prefs-snapshot.json

# store screenshots (regenerate with scripts/store-screenshots.mjs)
/store-screenshots
