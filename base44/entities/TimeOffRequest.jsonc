{
  "name": "TimeOffRequest",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "user_role": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "reason": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "declined"
      ],
      "default": "pending"
    },
    "reviewed_by": {
      "type": "string"
    },
    "decline_reason": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "user_name",
    "start_date",
    "end_date"
  ]
}